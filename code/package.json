{
  "name": "asistente-escolar-ai",
  "version": "2.0.0",
  "description": "Asistente educativo con IA para estudiantes - Versión optimizada con funcionalidades avanzadas",
  "main": "main.js",
  "author": "AsistenteEscolarAI Team",
  "license": "MIT",
  "homepage": "https://github.com/tu-usuario/asistente-escolar-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/asistente-escolar-ai.git"
  },
  "keywords": [
    "education",
    "ai",
    "student",
    "learning",
    "pomodoro",
    "calculator",
    "ocr",
    "electron",
    "productivity"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src/ --ext .js",
    "test": "jest",
    "clean": "rimraf dist build",
    "rebuild": "electron-rebuild"
  },
  "build": {
    "appId": "com.asistenteescolar.ai",
    "productName": "Asistente Escolar AI",
    "copyright": "Copyright © 2025 AsistenteEscolarAI Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*",
      "config/**/*",
      "public/**/*",
      "LICENSE",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config/licenses.json",
        "to": "resources/config/licenses.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publisherName": "AsistenteEscolarAI Team"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon.png",
      "category": "Education",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "public/icons/icon.ico",
      "uninstallerIcon": "public/icons/icon.ico",
      "installerHeaderIcon": "public/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Asistente Escolar AI",
      "include": "build/installer.nsh"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "public/icons/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 380,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 110,
          "y": 180,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "tu-usuario",
      "repo": "asistente-escolar-ai"
    }
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron": "^29.1.0",
    "tesseract.js": "^5.0.4",
    "robotjs": "^0.6.0",
    "fs-extra": "^11.2.0",
    "node-schedule": "^2.1.1",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "ia32",
    "arm64"
  ]
}
